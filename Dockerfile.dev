# ============================================================
# Photobooth Dev — Mac (และ Linux) ใช้กับ docker-compose.dev.yml
# Config PHP/Apache อยู่ใน docker/ — ไม่ต้องตั้งค่าบน host
# ============================================================

FROM php:8.4-apache

# รวมทุก apt ไว้ใน layer เดียว — ลด build time + image size
# Node.js 20 ต้องรัน nodesource setup ก่อน apt install
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        unzip \
        libzip-dev \
        libpng-dev \
        libfreetype6-dev \
        libjpeg62-turbo-dev \
        ca-certificates \
        curl \
        gnupg \
        ffmpeg \
        gphoto2 \
        libimage-exiftool-perl \
        rsync \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd zip ftp \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Apache: config จาก repo
RUN a2enmod rewrite \
    && echo "LimitRequestLine 12000" >> /etc/apache2/conf-available/photobooth-limits.conf \
    && a2enconf photobooth-limits.conf

WORKDIR /var/www/html

# Config ที่จบใน Docker (PHP + Apache)
# memory_limit ตั้งใน php.ini แล้ว — ไม่ต้องซ้ำที่นี่
COPY docker/php.ini /usr/local/etc/php/conf.d/photobooth.ini
COPY docker/apache-photobooth.conf /etc/apache2/sites-available/photobooth.conf
RUN a2dissite 000-default.conf && a2ensite photobooth.conf

# Print proxy สำหรับ dev (ส่งไป relay บน Mac) — --chmod แทน RUN chmod
COPY --chmod=755 docker/lp-print-proxy.sh /usr/local/bin/lp

# Script สร้าง config จาก env + entrypoint
COPY docker/generate-config.php docker/generate-config.php
COPY --chmod=755 docker/entrypoint-dev.sh /entrypoint-dev.sh

# ไม่ copy โปรเจกต์ใน image — จะ mount จาก host ตอนรัน; entrypoint จะ composer install + npm run build
RUN mkdir -p data/images data/thumbs data/print data/qr data/temp var private \
    && chown -R www-data:www-data .

ENTRYPOINT ["/entrypoint-dev.sh"]

EXPOSE 80
