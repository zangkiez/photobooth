# ตัวอย่างสำหรับ Production (Ubuntu / Raspberry Pi)
# Copy เป็น .env แล้วแก้ค่า — ไม่ต้องมีไฟล์ config บน host
# อัปเดตแค่: git pull && docker compose -f docker-compose.production.ubuntu.yml up -d --build

TZ=Asia/Bangkok

# URL ที่ผู้ใช้เปิดเข้า Photobooth (IP หรือ domain)
PHOTOBOOTH_WEBSERVER_URL=http://192.168.1.100

# ชื่อเครื่องพิมพ์จาก lpstat -p (ถ้าไม่ใช้พิมพ์ ลบบรรทัดนี้หรือไม่ใส่)
PHOTOBOOTH_PRINTER_NAME=Dai_Nippon_Printing_DP_QW410

# โหมดพรีวิว (device_cam | gphoto2 | libcamera | url)
# PHOTOBOOTH_PREVIEW_MODE=device_cam
